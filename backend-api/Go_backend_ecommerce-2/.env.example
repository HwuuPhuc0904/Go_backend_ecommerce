# .env.example

# Example environment variables for the Go backend e-commerce application

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Server configuration
SERVER_PORT=8080

# JWT configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=24h

# CORS configuration
CORS_ALLOWED_ORIGINS=*

# Logging configuration
LOG_LEVEL=info

# Other configurations
APP_NAME=Go E-commerce Application
APP_ENV=development